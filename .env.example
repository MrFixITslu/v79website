CANONICAL_DOMAIN=https://v79sl.com
# Existing installations: preserve your original key exactly. Blank uses data/.encryption_key.
ENCRYPTION_KEY=
# Optional first-install password, minimum 16 characters. Otherwise read data/.admin_setup_password.
ADMIN_PASSWORD=
ADMIN_EMAIL=vision79slu@gmail.com
ADMIN_RESET_TOKEN=
# Comma-separated exact trusted Nginx Proxy Manager container IPs/CIDRs. Never set to 1 or true.
TRUSTED_PROXIES=
# required (recommended); disabled is an explicit decision to rely on rate limits without CAPTCHA.
CAPTCHA_MODE=required
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
V79TIQUET_INTAKE_URL=http://v79-tiquet-manager:3050/api/public/intake
V79TIQUET_INTAKE_SECRET=
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5:3b
# Separate small CPU-friendly model for on-demand CRM scoring; never used to fetch contacts.
OLLAMA_CRM_MODEL=qwen2.5:1.5b
# OFF by default. An owner-approved release must explicitly enable public listing lookups.
CRM_PUBLIC_DISCOVERY_ENABLED=false
# Keep OFF on public Overpass servers; enable only with a suitably licensed commercial/self-hosted source.
CRM_OSM_DISCOVERY_ENABLED=false
# Licensed commercial Places API provider. Provide your own key via server secrets only.
# Both values are required; no API key is exposed to the browser or written to logs.
CRM_GEOAPIFY_DISCOVERY_ENABLED=false
GEOAPIFY_API_KEY=
GEMINI_API_KEY=


# Phase 2 V79 Hub business-event publisher.
# V79_HUB_ORGANIZATION_REF is the Hub organisation slug (for example v79-digital).
V79_HUB_EVENT_URL=http://v79-hub:3040/api/platform/events
V79_HUB_EVENT_SECRET=
V79_HUB_ORGANIZATION_REF=

# Shared with V79 Hub for signed read-only Owner Assistant summaries.
V79_PLATFORM_SHARED_SECRET=
